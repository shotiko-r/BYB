# Local development examples only; use different secret credentials in production.
# Database
POSTGRES_USER=byb
POSTGRES_PASSWORD=byb
POSTGRES_DB=byb
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql://byb:byb@localhost:5432/byb
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: NEXT_PUBLIC_API_URL is a required public HTTPS origin at frontend BUILD time.
# Frontend runtime: NODE_ENV=production, PORT (default 3000).
# Backend runtime: NODE_ENV=production, PORT (default 3001), DATABASE_URL (secret),
# FRONTEND_URL (exact public HTTPS frontend origin), optional LOG_LEVEL.
# PostgreSQL provisioning: POSTGRES_USER, POSTGRES_PASSWORD (secret), POSTGRES_DB.
# PostgreSQL stays private; frontend must never connect to it.
# Never place production secrets in this file or Docker build arguments.
# Optional backend-only eBay compliance token: use the same secret in eBay's portal.
# Production: EBAY_MARKETPLACE_DELETION_VERIFICATION_TOKEN=<secret>
EBAY_MARKETPLACE_DELETION_VERIFICATION_TOKEN=

# Backend-only Browse discovery; credentials required only in real mode.
EBAY_PROVIDER_MODE=mock
EBAY_ENVIRONMENT=production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Backend-only Phase B dry-run. Keep disabled by default. Actual URL is a runtime secret.
ADMITAD_ALIEXPRESS_FEED_URL=
ADMITAD_ALIEXPRESS_FEED_ENABLED=false
ADMITAD_ALIEXPRESS_FEED_MARKETS=GE
ADMITAD_ALIEXPRESS_FEED_MAX_PRODUCTS=5000
ADMITAD_ALIEXPRESS_FEED_MAX_BYTES=104857600
ADMITAD_ALIEXPRESS_FEED_MAX_DURATION_SECONDS=120

# Phase D: persisted AliExpress search (independent of importer enablement/URL).
# Use alongside EBAY_PROVIDER_MODE=real to keep live eBay results.
ALIEXPRESS_SEARCH_ENABLED=false
ADMITAD_ALIEXPRESS_FEED_MAX_AGE_HOURS=24
